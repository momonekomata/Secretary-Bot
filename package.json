{
  "name": "secretary-bot",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Personal AI secretary and news curator for Telegram and LINE, powered by Gemini or Claude",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "google-auth": "tsx scripts/google-auth.ts",
    "setup-gcp": "bash scripts/setup-gcp.sh",
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@google/genai": "^3.0.0",
    "tsx": "^4.23.15",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "5.6",
    "vitest": "^2.1.9"
  }
}
