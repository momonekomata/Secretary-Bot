# Easiest: run `npm run setup`. Or copy this file to .env and fill it in. Never commit the real .env.

# --- Claude (required) ---  https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# BOT_MODEL=claude-opus-5-5        # default; claude-sonnet-5-5 or claude-haiku-5-5 cost less
# BOT_EFFORT=medium                # low | medium | high | xhigh | max

# --- Personality ---
BOT_NAME=Tabi
BOT_TIMEZONE=Asia/Bangkok
# BOT_PERSONA=Be cheerful and call me senpai. Explain Japanese grammar with Thai examples.
# BOT_WEB_TOOLS=on                 # off disables web search / web fetch
# BOT_HISTORY_LIMIT=40             # messages of conversation kept per chat

# --- Telegram (optional) ---  token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your numeric user id. Leave empty, message the bot, and it tells you.
TELEGRAM_ALLOWED_USERS=
# TELEGRAM_MODE=polling            # or webhook (then set TELEGRAM_WEBHOOK_URL=https://<host>/telegram)
# TELEGRAM_WEBHOOK_URL=
# TELEGRAM_WEBHOOK_SECRET=         # any random string; checked on every webhook call

# --- LINE (optional) ---  LINE Developers console > Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Your LINE user id (starts with U). Leave empty, message the bot, and it tells you.
LINE_ALLOWED_USERS=

# --- Japanese study (optional) ---
# WaniKani token (wanikani.com > Settings > API Tokens, no permissions needed)
WANIKANI_TOKEN=
# Daily nudge when reviews or lessons are waiting: local hour, and which chats get it.
# BOT_DAILY_NUDGE_HOUR=20
# BOT_DAILY_NUDGE_CHATS=telegram:123456789,line:Uxxxxxxxx

# PORT=8787
# BOT_DATA_DIR=./data
