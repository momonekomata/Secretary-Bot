# Easiest: run `npm run setup`. Or copy this file to .env and fill it in. Never commit the real .env.
# On a NAS you can also put this file at data/.env.

# --- AI (at least one) ---
# Gemini (default AI, also needed for voice notes): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude (optional, switch to it in /settings): https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# BOT_MODEL=gemini-3.8-flash       # starting model; also gemini-4-argon, claude-sonnet-5-5, claude-opus-5-5, claude-haiku-5-5
# BOT_EFFORT=medium                # thinking effort: low | medium | high
# VOICE_MODEL=gemini-3.8-flash     # Gemini model that transcribes voice notes
# VOICE_TRANSLATE_TO=English       # language voice notes are translated into (also in /settings)
# MODEL_PRICES={"gemini-3.8-flash":{"input":0.75,"output":3.75}}   # USD per 1M tokens, for /stats and caps

# --- Spending limits (USD per day, your time zone) ---
# Per provider: a cap pauses only that provider's models (voice notes and spoken replies are Gemini).
# These are the starting values: change them any time in chat with /limit (e.g. /limit gemini 1).
# e.g. Gemini inside a $10/month Google AI Pro credit, Claude inside a $100/month Claude Max credit.
GEMINI_DAILY_WARNING_LIMIT_USD=0.20
GEMINI_DAILY_HARD_LIMIT_USD=0.30
CLAUDE_DAILY_WARNING_LIMIT_USD=2.50
CLAUDE_DAILY_HARD_LIMIT_USD=3.00
# Optional overall limits for all AI together:
# DAILY_WARNING_LIMIT_USD=
# DAILY_HARD_LIMIT_USD=
# LOG_RETENTION_DAYS=30            # older usage logs are archived to data/backups nightly

# --- Personality ---
BOT_NAME=Tabi
BOT_TIMEZONE=Asia/Bangkok
# BOT_PERSONA=Be cheerful and call me boss. Explain Japanese grammar with Thai examples.
# BOT_WEB_TOOLS=on                 # off disables web search and page reading (Gemini and Claude)
# BOT_HISTORY_LIMIT=40             # messages of conversation kept per chat

# --- Telegram ---  token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your numeric user id. Leave empty, message the bot, and it tells you.
TELEGRAM_ALLOWED_USERS=
# TELEGRAM_MODE=polling            # or webhook (then set TELEGRAM_WEBHOOK_URL=https://<host>/telegram)
# TELEGRAM_WEBHOOK_URL=
# TELEGRAM_WEBHOOK_SECRET=

# --- LINE (optional) ---  LINE Developers console > Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ALLOWED_USERS=

# --- Scheduled messages ---
# Where briefings and alerts go: your chat key from /id, e.g. telegram:123456789 (comma-separate several)
BOT_NOTIFY_CHATS=
# Local times (HH:MM); leave empty to turn one off.
# WEATHER_TIME=07:00
# BRIEFING_TIME=08:00
# WEEKEND_PLANNER_DAY=fri
# WEEKEND_PLANNER_TIME=16:00
# CLEANUP_TIME=03:00
# JAPANESE_TIME=12:00              # kanji and word of the day
# MONEY_CHECK_TIME=21:00           # read new receipts/card alerts from Gmail, budget warnings (empty disables)
# BOT_ANNOUNCE_STARTUP=on          # message you when a new version starts (after Watchtower updates)

# --- News ---
# NEWS_TOPICS=Artificial Intelligence,Global Economy,Thailand   # starting watchlist; change with /addtopic
# NEWS_LANGUAGE=en-US              # e.g. th for Thai headlines
# NEWS_COUNTRY=US                  # e.g. TH

# --- Weather ---
WEATHER_CITY=Bangkok               # change any time with /setcity
# AQI_ALERT_THRESHOLD=100          # alert once a day when US AQI goes above this

# --- Google (Calendar, Gmail, Tasks, Drive, Docs, Sheets, Contacts) ---
# No settings here: put credentials.json in data/ and run `npm run google-auth` (see SETUP-GUIDE.md).
# Google Maps (places, travel times): API key with Places API (New) and Routes API enabled.
GOOGLE_MAPS_API_KEY=

# Android Health Connect export: the folder inside the container where its daily .zip lands (mounted in docker-compose.yml).
# HEALTH_CONNECT_DIR=/healthconnect

# USDA FoodData Central (nutrition of ingredients/generic foods). Optional: without it the shared DEMO_KEY is used,
# which allows only a few lookups an hour. Free key: sign up on the FoodData Central website (API key signup).
# USDA_API_KEY=

# --- Gemini through Vertex AI (optional: Google Cloud credit pays for Gemini) ---
# Put a service-account key at data/vertex-key.json (SETUP-GUIDE.md, Part 6); the Gemini API key stays as backup.
# GEMINI_VIA_VERTEX=on        # off = keep using only the Gemini API key
# VERTEX_LOCATION=global
# VERTEX_PROJECT=             # read from the key file when empty
# VERTEX_KEY_FILE=data/vertex-key.json

# --- Spoken replies (Gemini text-to-speech; needs ffmpeg, included in the Docker image) ---
# VOICE_REPLIES=voice-notes        # off | voice-notes (answer voice notes with voice) | always; also /voice in chat
# TTS_MODEL=gemini-3.8-flash-tts   # tried first; if unavailable the bot falls back to older Gemini speech models
# TTS_VOICE=Kore

# --- Public address (LINE webhook, LINE voice replies, file download links) ---
# e.g. your Tailscale Funnel or Cloudflare Tunnel address. The bot sets the LINE webhook to PUBLIC_URL/line itself.
# PUBLIC_URL=https://my-nas.tail1234.ts.net

# --- Japanese study ---
# WANIKANI_TOKEN=
# BOT_DAILY_NUDGE_HOUR=20

# PORT=8787
# BOT_DATA_DIR=./data
